# SocioDrift Video AI Pipeline Configuration

# Default temporal segmentation duration in seconds
SOCIODRIFT_SEGMENT_DURATION=3.0

# Default output directory for JSON analyses
SOCIODRIFT_OUTPUT_DIR=outputs

# Optional: Set to 1 to enable deterministic offline demo mode
SOCIODRIFT_DEMO_MODE=0

# Log level (DEBUG, INFO, WARNING, ERROR)
SOCIODRIFT_LOG_LEVEL=INFO
